#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${project_root}"

module="$(go list -m)"
proto_files="$(find api -type f -name '*.proto' | sort)"
if [[ -z "${proto_files}" ]]; then
  echo "没有需要生成的proto文件"
  exit 0
fi

# api/client只生成消息；api/server额外生成使用Wali RPC Client的gRPC代码。
# 文件名由脚手架约束，不允许包含空格。
protoc \
  --proto_path=. \
  --go_out=. \
  --go_opt=module="${module}" \
  --go-grpc-locator_out=. \
  --go-grpc-locator_opt=module="${module}" \
  ${proto_files}
