package bootstrap

import (
	"github.com/2comjie/wali/deploy"
	"github.com/2comjie/wali/flag"
	"github.com/2comjie/wali/locator"
	redisLocator "github.com/2comjie/wali/locator/redis"
	"github.com/2comjie/wali/registry"
	redisRegistry "github.com/2comjie/wali/registry/redis"
	walirpc "github.com/2comjie/wali/rpc/client"
	"github.com/redis/go-redis/v9"
	projectrpc "{{.Module}}/internal/rpcclient"
)

// Infrastructure 是所有App共用的基础设施。
type Infrastructure struct {
	Redis     redis.UniversalClient
	Registry  registry.Registry
	Discover  registry.Discover
	Locator   locator.Locator
	RPCClient *walirpc.Client
}

// NewInfrastructure 创建Redis Registry、Discover、Locator和RPC Client。
func NewInfrastructure() *Infrastructure {
	redisClient := redis.NewUniversalClient(&redis.UniversalOptions{
		Addrs: []string{flag.String("redis", "127.0.0.1:6379")},
	})
	registryProvider := redisRegistry.NewRegistry(redisClient)
	discoverProvider := redisRegistry.NewDiscover(redisClient)
	locatorProvider := redisLocator.NewProvider(redisClient)
	baseRPCClient := walirpc.NewClient(discoverProvider, locatorProvider)
	projectrpc.Init(baseRPCClient)
	return &Infrastructure{
		Redis:     redisClient,
		Registry:  registryProvider,
		Discover:  discoverProvider,
		Locator:   locatorProvider,
		RPCClient: baseRPCClient,
	}
}

// DeployOptions 返回Gate和Node共用的部署参数。
func (i *Infrastructure) DeployOptions() []deploy.Option {
	return []deploy.Option{
		deploy.WithRegistry(i.Registry),
		deploy.WithDiscover(i.Discover),
		deploy.WithLocator(i.Locator),
		deploy.WithRPCClient(i.RPCClient),
	}
}
